generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

model Message {
    id        String   @id @default(uuid())
    text      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("messages")
}
